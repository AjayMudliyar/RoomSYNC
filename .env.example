# ==============================================================================
# RoomSync Environment Template (Non-Secret Placeholders Only)
# Copy to `.env` for local development. NEVER commit real secrets or `.env`.
# ==============================================================================

# --- Environment ---
ENVIRONMENT=local

# --- Django Backend (services/backend) ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-long-random-local-dev-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL (authoritative system of record) ---
POSTGRES_DB=roomsync
POSTGRES_USER=roomsync
POSTGRES_PASSWORD=roomsync_local_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql://roomsync:roomsync_local_dev_password@db:5432/roomsync

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Internal Matching Service (services/matching — private network only) ---
FASTAPI_BASE_URL=http://matching:8001
MATCHING_SERVICE_PORT=8001
INTERNAL_SERVICE_TOKEN=replace-with-local-internal-service-token
FASTAPI_TIMEOUT_SECONDS=3.0

# --- Web Origins, CORS & CSRF ---
WEB_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# --- Auth & Google OAuth (P0 — supply real credentials only via runtime env) ---
JWT_SIGNING_KEY=replace-with-local-jwt-signing-secret
JWT_ISSUER=https://api.roomsync.local
JWT_AUDIENCE=roomsync-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_FAMILY_MAX_DAYS=30
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_SECRET_WEB=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
TRUSTED_PROXY_COUNT=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=RoomSync <no-reply@roomsync.local>

# --- S3-Compatible Storage (MinIO locally; isolated public & private buckets) ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_PUBLIC=roomsync-public
S3_BUCKET_PRIVATE=roomsync-private
S3_ACCESS_KEY_ID=roomsync_minio
S3_SECRET_ACCESS_KEY=roomsync_minio_local_secret
MINIO_ROOT_USER=roomsync_minio
MINIO_ROOT_PASSWORD=roomsync_minio_local_secret

# --- Client Public Variables ONLY (never place backend secrets here) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Optional Operator Tools (Docker profile: tools — 127.0.0.1 only) ---
PGADMIN_DEFAULT_EMAIL=admin@roomsync.local
PGADMIN_DEFAULT_PASSWORD=replace-with-local-pgadmin-password
